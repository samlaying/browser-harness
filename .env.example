# Copy to .env — auto-loaded. Only needed for remote browsers.
BROWSER_USE_API_KEY=bu_your_key_here

# Xiaohongshu crawler (xhs-crawler skill) — image OCR via SiliconFlow VL models.
# Used by .claude/skills/xhs-crawler/scripts/xhs_ocr.py to read text out of note/comment images.
# Sign up with this invite link for free credits: https://cloud.siliconflow.cn/i/RJfe45SI
XSF_KEY=sk-your_siliconflow_key_here
XHS_VL_MODEL=Qwen/Qwen3-VL-32B-Instruct
# Optional tuning: XHS_OCR_WORKERS (default 8), XHS_OCR_LIMIT (only OCR first N images)
